<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comunidad"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_search"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <!-- Tarjeta Amigos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAmigos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/icon1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_group"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:text="Amigos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon1"
                app:layout_constraintTop_toTopOf="@id/icon1"/>

            <TextView
                android:text="Consulta tu lista y añade nuevos"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon1"
                app:layout_constraintEnd_toStartOf="@id/arrow1"
                app:layout_constraintTop_toBottomOf="@+id/textViewAmigosTitle"/>

            <TextView
                android:id="@+id/textViewAmigosTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toEndOf="@id/icon1"
                app:layout_constraintTop_toTopOf="@id/icon1"/>

            <ImageView
                android:id="@+id/arrow1"
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Añadir Amigos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAnadirAmigos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/icon2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_person_add"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:text="Añadir Amigos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon2"
                app:layout_constraintTop_toTopOf="@id/icon2"/>

            <TextView
                android:text="Busca y gestiona solicitudes"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon2"
                app:layout_constraintTop_toBottomOf="@+id/tvAux2"/>

            <TextView
                android:id="@+id/tvAux2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toEndOf="@id/icon2"
                app:layout_constraintTop_toTopOf="@id/icon2"/>

            <ImageView
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Clasificación General -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/icon3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_leaderboard"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:text="Clasificación General"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon3"
                app:layout_constraintTop_toTopOf="@id/icon3"/>

            <TextView
                android:text="Compite en el ranking gamificado"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon3"
                app:layout_constraintTop_toBottomOf="@+id/tvAux3"/>

            <TextView
                android:id="@+id/tvAux3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toEndOf="@id/icon3"
                app:layout_constraintTop_toTopOf="@id/icon3"/>

            <ImageView
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Grupos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardGrupos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/icon4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_forum"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:text="Grupos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon4"
                app:layout_constraintTop_toTopOf="@id/icon4"/>

            <TextView
                android:text="Explora listados y publicaciones"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon4"
                app:layout_constraintTop_toBottomOf="@+id/tvAux4"/>

            <TextView
                android:id="@+id/tvAux4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toEndOf="@id/icon4"
                app:layout_constraintTop_toTopOf="@id/icon4"/>

            <ImageView
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>