<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── HEADER con degradado ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_header"
            android:paddingTop="36dp"
            android:paddingBottom="40dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comunidad"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/tvTitle"
                android:layout_alignBottom="@id/tvTitle"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conecta, compite y comparte"
                android:textColor="#C0C0C0"
                android:textSize="13sp"
                android:layout_below="@id/tvTitle"
                android:layout_marginTop="4dp"/>
        </RelativeLayout>

        <!-- ── TARJETA DE STATS (3 columnas) ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-26dp"
            app:cardBackgroundColor="#161618"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤝"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amigos"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="#2A2A2A"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ranking"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="#2A2A2A"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grupos"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── SECCIÓN ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explora"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"/>

        <!-- Tarjeta Amigos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAmigos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/icon1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_group"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titAmigos"
                android:text="Amigos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon1"
                app:layout_constraintEnd_toStartOf="@id/arrow1"
                app:layout_constraintTop_toTopOf="@id/icon1"/>

            <TextView
                android:text="Consulta tu lista, busca y gestiona solicitudes"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon1"
                app:layout_constraintEnd_toStartOf="@id/arrow1"
                app:layout_constraintTop_toBottomOf="@id/titAmigos"/>

            <ImageView
                android:id="@+id/arrow1"
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Clasificación -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/icon3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_leaderboard"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titRanking"
                android:text="Clasificación General"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon3"
                app:layout_constraintEnd_toStartOf="@id/arrow3"
                app:layout_constraintTop_toTopOf="@id/icon3"/>

            <TextView
                android:text="Compite en el ranking gamificado"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon3"
                app:layout_constraintEnd_toStartOf="@id/arrow3"
                app:layout_constraintTop_toBottomOf="@id/titRanking"/>

            <ImageView
                android:id="@+id/arrow3"
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tarjeta Grupos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardGrupos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:id="@+id/icon4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_red"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:src="@drawable/ic_forum"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:tint="@color/white"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titGrupos"
                android:text="Grupos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon4"
                app:layout_constraintEnd_toStartOf="@id/arrow4"
                app:layout_constraintTop_toTopOf="@id/icon4"/>

            <TextView
                android:text="Explora listados y publicaciones"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/icon4"
                app:layout_constraintEnd_toStartOf="@id/arrow4"
                app:layout_constraintTop_toBottomOf="@id/titGrupos"/>

            <ImageView
                android:id="@+id/arrow4"
                android:src="@drawable/ic_chevron_right"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:tint="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>