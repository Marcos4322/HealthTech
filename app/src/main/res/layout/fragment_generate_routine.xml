<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volver"
                    app:tint="@color/white"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Generar Rutina"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Crea tu rutina"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responde 4 preguntas y nuestra IA creará una rutina perfecta para ti."
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

            <!-- PREGUNTA 1: OBJETIVO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Cuál es tu objetivo?"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupObjetivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="24dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipObjPerderGrasa"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perder grasa"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipObjGanarMusculo"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ganar músculo"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipObjTonificar"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tonificar"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipObjResistencia"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resistencia"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- PREGUNTA 2: NIVEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Cuál es tu nivel?"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupNivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="24dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNivPrincipiante"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Principiante"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNivIntermedio"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intermedio"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNivAvanzado"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avanzado"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- PREGUNTA 3: DÍAS POR SEMANA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="¿Cuántos días por semana?"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDiasValor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/fitsync_red"
                    android:textSize="28sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="7"
                android:value="3"
                android:stepSize="1"
                app:thumbColor="@color/fitsync_red"
                app:trackColorActive="@color/fitsync_red"
                app:trackColorInactive="#3A3A3A"
                android:layout_marginBottom="24dp"/>

            <!-- PREGUNTA 4: EQUIPAMIENTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué equipamiento tienes?"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEquipamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="32dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEqNinguno"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin equipo (casa)"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEqCasaBasico"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mancuernas en casa"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEqGimnasioCompleto"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gimnasio completo"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/chip_state_color"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- BOTÓN GENERAR -->
            <Button
                android:id="@+id/btnGenerar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✨ Generar mi rutina"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/fitsync_red"
                app:cornerRadius="28dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La generación tarda 10-25 segundos"
                android:textColor="#808080"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay de loading (oculto por defecto) -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/fitsync_red"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ La IA está creando tu rutina..."
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esto puede tardar 10-25 segundos"
                android:textColor="#B0B0B0"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>